# Modelo de configuração. Copie este arquivo para ".env" e ajuste os valores.
# O ".env" é local e NUNCA vai para o Git (está no .gitignore).

# Endereço do servidor Ollama. Rodando no seu computador, o padrão é este:
LLM_URL=http://localhost:11434

# Nome do modelo baixado com "ollama pull" (confira com "ollama list"):
LLM_MODEL=qwen3.5:9b-q4_K_M

# Tempo máximo, em segundos, para esperar a resposta do LLM.
# Na CPU a primeira resposta é lenta, porque o modelo é carregado na memória.
LLM_TIMEOUT=120

# Verificar o certificado HTTPS do servidor do LLM (padrão: true).
# Use "false" só em servidores internos com certificado autoassinado, como a plataforma Devel.
# No Ollama local (http://localhost) esta opção não tem efeito.
LLM_VERIFY_SSL=true
